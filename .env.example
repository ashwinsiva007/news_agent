# AI Morning Research Agent - Environment Variables Template
# Copy this file to .env and insert your API keys if you wish to use AI generation.
# If no keys are configured, the agent runs in 100% free deterministic extractive mode.

# AI Provider ("gemini", "openai", or "none")
AI_PROVIDER=gemini

# Google Gemini API Key (Recommended for fast, accessible free tier)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-1.5-flash

# OpenAI / Compatible Provider (Alternative)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL_NAME=gpt-4o-mini
